{{ 'yumi-pdp.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} .y-section { --y-bg: {{ section.settings.background }}; --y-pt: {{ section.settings.padding_top }}px; --y-pb: {{ section.settings.padding_bottom }}px; --y-width: {{ section.settings.max_width }}px; }
</style>

<div class="y-section">
  <div class="y-container">
    <div class="y-center">
      {%- if section.settings.eyebrow != blank -%}<span class="y-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="y-heading y-h2 y-hl-text">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="y-faq"{% if section.settings.columns == '1' %} style="grid-template-columns:minmax(0,1fr)"{% endif %}>
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}<span class="y-plus" aria-hidden="true"></span></summary>
          <div class="y-accordion__content y-rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "YUMI FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Überschrift" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Häufig gestellte Fragen" },
    { "type": "select", "id": "columns", "label": "Spalten (Desktop)", "default": "2", "options": [
      { "value": "1", "label": "1" }, { "value": "2", "label": "2" }
    ] },
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "background", "label": "Hintergrundfarbe", "default": "#ffffff" },
    { "type": "range", "id": "max_width", "label": "Max. Breite", "min": 600, "max": 1400, "step": 20, "unit": "px", "default": 900 },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Frage",
      "settings": [
        { "type": "text", "id": "question", "label": "Frage", "default": "Wie trage ich sie auf?" },
        { "type": "richtext", "id": "answer", "label": "Antwort", "default": "<p>Eine kleine Menge mit den Fingern, einem Pinsel oder einem Schwämmchen auftragen und sanft verblenden. Die Pigmente passen sich in wenigen Sekunden an.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "YUMI FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Wie trage ich sie auf?" } },
        { "type": "question", "settings": { "question": "Wie lange hält sie?", "answer": "<p>Bis zu 16 Stunden – ohne Nachpudern.</p>" } },
        { "type": "question", "settings": { "question": "Wie stark ist die Deckkraft?", "answer": "<p>Leicht bis mittel und schichtbar – für ein natürliches Ergebnis.</p>" } },
        { "type": "question", "settings": { "question": "Ist sie für empfindliche Haut geeignet?", "answer": "<p>Ja, die Formel ist dermatologisch getestet und parfümfrei.</p>" } },
        { "type": "question", "settings": { "question": "Wie funktioniert die Geld-zurück-Garantie?", "answer": "<p>Du hast 30 Tage Zeit, die Foundation zu testen. Bist du nicht zufrieden, erstatten wir dir den Kaufpreis.</p>" } },
        { "type": "question", "settings": { "question": "Wohin versendet ihr?", "answer": "<p>Wir versenden nach Deutschland, Österreich und in die Schweiz.</p>" } },
        { "type": "question", "settings": { "question": "Kann ich meine Bestellung zurückgeben?", "answer": "<p>Ja, innerhalb von 30 Tagen nach Erhalt.</p>" } },
        { "type": "question", "settings": { "question": "Fallen Zölle oder Steuern an?", "answer": "<p>Innerhalb der EU fallen keine zusätzlichen Zölle an.</p>" } }
      ]
    }
  ]
}
{% endschema %}
