{{ 'yumi-pdp.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} .y-section { --y-bg: {{ section.settings.background }}; --y-pt: {{ section.settings.padding_top }}px; --y-pb: {{ section.settings.padding_bottom }}px; --y-width: {{ section.settings.max_width }}px; }
</style>

<div class="y-section">
  <div class="y-container">
    <div class="y-center">
      {%- if section.settings.eyebrow != blank -%}<span class="y-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="y-heading y-h2 y-hl-text">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="y-faq"{% if section.settings.columns == '1' %} style="grid-template-columns:minmax(0,1fr)"{% endif %}>
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}<span class="y-plus" aria-hidden="true"></span></summary>
          <div class="y-accordion__content y-rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "YUMI FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Überschrift" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Frequently asked questions" },
    { "type": "select", "id": "columns", "label": "Spalten (Desktop)", "default": "2", "options": [
      { "value": "1", "label": "1" }, { "value": "2", "label": "2" }
    ] },
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "background", "label": "Hintergrundfarbe", "default": "#ffffff" },
    { "type": "range", "id": "max_width", "label": "Max. Breite", "min": 600, "max": 1400, "step": 20, "unit": "px", "default": 900 },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Frage",
      "settings": [
        { "type": "text", "id": "question", "label": "Frage", "default": "How do I apply it?" },
        { "type": "richtext", "id": "answer", "label": "Antwort", "default": "<p>Apply a small amount with your fingers, a brush or a sponge and blend gently. The pigments adapt within seconds.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "YUMI FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "How do I apply it?" } },
        { "type": "question", "settings": { "question": "How long does it last?", "answer": "<p>Up to 16 hours, with no touch-ups needed.</p>" } },
        { "type": "question", "settings": { "question": "What's the coverage like?", "answer": "<p>Light to medium and buildable — for a natural finish.</p>" } },
        { "type": "question", "settings": { "question": "Is it suitable for sensitive skin?", "answer": "<p>Yes, the formula is dermatologically tested and fragrance-free.</p>" } },
        { "type": "question", "settings": { "question": "How does the money-back guarantee work?", "answer": "<p>You have 30 days to try the foundation. If you're not happy, we'll refund your purchase.</p>" } },
        { "type": "question", "settings": { "question": "Where do you ship to?", "answer": "<p>We ship Australia-wide, with free shipping on every order.</p>" } },
        { "type": "question", "settings": { "question": "Can I return my order?", "answer": "<p>Yes, within 30 days of delivery.</p>" } },
        { "type": "question", "settings": { "question": "Do I have to pay duties or taxes?", "answer": "<p>No. Orders within Australia have no extra duties or taxes. GST is included in the price.</p>" } }
      ]
    }
  ]
}
{% endschema %}
