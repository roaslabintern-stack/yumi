<style>
  #shopify-section-{{ section.id }} .yumi-footer {
    --yf-bg: {{ section.settings.background_color }};
    --yf-text: {{ section.settings.text_color }};
    --yf-muted: {{ section.settings.muted_color }};
    --yf-accent: {{ section.settings.accent_color }};
  }
</style>

<footer class="yumi-footer">
  <div class="yumi-footer__inner">
    <div class="yumi-footer__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'brand' -%}
            <div class="yumi-footer__col yumi-footer__col--brand" {{ block.shopify_attributes }}>
              {%- if block.settings.logo != blank -%}
                <img class="yumi-footer__logo" src="{{ block.settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="{{ block.settings.logo_width }}" height="{{ block.settings.logo_width | divided_by: block.settings.logo.aspect_ratio | round }}" loading="lazy" style="width: {{ block.settings.logo_width }}px">
              {%- endif -%}
              {%- if block.settings.text != blank -%}<div class="yumi-footer__text">{{ block.settings.text }}</div>{%- endif -%}
            </div>
          {%- when 'menu' -%}
            {%- if block.settings.menu == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
            <div class="yumi-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<p class="yumi-footer__heading">{{ block.settings.heading }}</p>{%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="yumi-footer__links" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- when 'text' -%}
            <div class="yumi-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<p class="yumi-footer__heading">{{ block.settings.heading }}</p>{%- endif -%}
              <div class="yumi-footer__text">{{ block.settings.text }}</div>
            </div>
          {%- when 'newsletter' -%}
            <div class="yumi-footer__col yumi-footer__col--newsletter" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<p class="yumi-footer__heading">{{ block.settings.heading }}</p>{%- endif -%}
              {%- if block.settings.text != blank -%}<div class="yumi-footer__text">{{ block.settings.text }}</div>{%- endif -%}
              {%- assign newsletter_form_id = 'YumiNewsletter-' | append: section.id -%}
              {%- form 'customer', id: newsletter_form_id, class: 'yumi-footer__form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="visually-hidden" for="YumiNewsletterEmail-{{ block.id }}">E-Mail</label>
                <input id="YumiNewsletterEmail-{{ block.id }}" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ block.settings.placeholder | escape }}">
                <button type="submit" aria-label="{{ block.settings.button_label | escape }}">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </button>
                {%- if form.posted_successfully? -%}
                  <p class="yumi-footer__success" role="status">{{ block.settings.success_text }}</p>
                {%- elsif form.errors -%}
                  <p class="yumi-footer__success" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="yumi-footer__bottom">
      <p class="yumi-footer__copy">© {{ 'now' | date: '%Y' }} {{ section.settings.copyright | default: shop.name }}</p>
      {%- if section.settings.show_payment_icons -%}
        <ul class="yumi-footer__payments" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.show_policies -%}
        <ul class="yumi-footer__policies" role="list">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

<style>
  .yumi-footer { background: var(--yf-bg); color: var(--yf-text); font-family: var(--font-body-family); }
  .yumi-footer a { color: inherit; text-decoration: none; }
  .yumi-footer__inner { max-width: 1120px; margin: 0 auto; padding: {{ section.settings.padding_top }}px 20px 24px; }
  .yumi-footer__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 20px; }
  .yumi-footer__col--brand, .yumi-footer__col--newsletter { grid-column: 1 / -1; }
  @media screen and (min-width: 990px) {
    .yumi-footer__grid { grid-template-columns: 1.4fr repeat(3, minmax(0, 1fr)) 1.6fr; gap: 40px; }
    .yumi-footer__col--brand, .yumi-footer__col--newsletter { grid-column: auto; }
  }
  .yumi-footer__logo { height: auto; max-width: 100%; margin-bottom: 14px; }
  .yumi-footer__heading { margin: 0 0 14px; font-size: 1.15rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--yf-muted); }
  .yumi-footer__links { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .yumi-footer__links a { font-size: 1.4rem; opacity: 0.9; transition: color .15s ease; }
  .yumi-footer__links a:hover { color: var(--yf-accent); opacity: 1; }
  .yumi-footer__text { font-size: 1.4rem; line-height: 1.6; color: var(--yf-text); opacity: 0.85; }
  .yumi-footer__text p { margin: 0 0 8px; }
  .yumi-footer__form { position: relative; margin-top: 14px; max-width: 420px; }
  .yumi-footer__form input[type="email"] { width: 100%; height: 48px; border-radius: 999px; border: 1px solid rgba(255,255,255,.25); background: rgba(255,255,255,.06); color: var(--yf-text); padding: 0 56px 0 20px; font: inherit; font-size: 1.4rem; }
  .yumi-footer__form input[type="email"]::placeholder { color: var(--yf-muted); }
  .yumi-footer__form input[type="email"]:focus { outline: 2px solid var(--yf-accent); outline-offset: 1px; }
  .yumi-footer__form button { position: absolute; top: 5px; right: 5px; width: 38px; height: 38px; border-radius: 50%; border: 0; background: var(--yf-accent); color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer; }
  .yumi-footer__success { font-size: 1.3rem; margin: 10px 0 0; }
  .yumi-footer__bottom { margin-top: 40px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,.12); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; }
  .yumi-footer__copy { margin: 0; font-size: 1.2rem; color: var(--yf-muted); }
  .yumi-footer__payments { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .yumi-footer__payments svg { width: 38px; height: 24px; display: block; }
  .yumi-footer__policies { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 1.2rem; color: var(--yf-muted); }
  @media screen and (max-width: 749px) {
    .yumi-footer__bottom { flex-direction: column; align-items: flex-start; }
  }
</style>

{% schema %}
{
  "name": "YUMI Footer",
  "tag": "section",
  "class": "yumi-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "copyright", "label": "Copyright-Name", "info": "Leer lassen für den Shop-Namen." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Zahlungs-Icons anzeigen", "default": true },
    { "type": "checkbox", "id": "show_policies", "label": "Rechtliche Seiten anzeigen", "default": true },
    { "type": "header", "content": "Farben" },
    { "type": "color", "id": "background_color", "label": "Hintergrund", "default": "#1d1a1c" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "muted_color", "label": "Überschriften / dezenter Text", "default": "#b7aeb3" },
    { "type": "color", "id": "accent_color", "label": "Akzent", "default": "#e0609b" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 16, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marke",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo (hell)" },
        { "type": "range", "id": "logo_width", "label": "Logo-Breite", "min": 60, "max": 240, "step": 10, "unit": "px", "default": 120 },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Koreanische Beauty-Innovation für reife Haut – entwickelt, um dich jeden Tag wohlzufühlen.</p>" }
      ]
    },
    {
      "type": "menu",
      "name": "Menü",
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menü", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Kontakt" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Mo–Fr, 9–17 Uhr<br/>support@yumi-cosmetics.de</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Newsletter" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Erhalte exklusive Angebote, neue Produkte und Beauty-Tipps.</p>" },
        { "type": "text", "id": "placeholder", "label": "Platzhalter", "default": "Deine E-Mail-Adresse" },
        { "type": "text", "id": "button_label", "label": "Button-Beschriftung (Screenreader)", "default": "Anmelden" },
        { "type": "text", "id": "success_text", "label": "Erfolgsmeldung", "default": "Danke für deine Anmeldung!" }
      ]
    }
  ],
  "presets": [
    {
      "name": "YUMI Footer",
      "blocks": [
        { "type": "brand" },
        { "type": "menu", "settings": { "heading": "Shop", "menu": "main-menu" } },
        { "type": "menu", "settings": { "heading": "Hilfe", "menu": "footer" } },
        { "type": "text" },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
