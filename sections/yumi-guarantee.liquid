{{ 'yumi-pdp.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} .y-section {
    --y-bg: {{ section.settings.background | default: '#fbe4ee' }};
    --y-pt: {{ section.settings.padding_top }}px;
    --y-pb: {{ section.settings.padding_bottom }}px;
    --y-width: {{ section.settings.max_width }}px;
    --g-btn: {{ section.settings.button_color }};
  }
</style>

<div class="y-section">
  <div class="y-container">
    <div class="y-guar">
      <div class="y-guar__seal">
        {%- if section.settings.seal_image != blank -%}
          {%- assign seal_alt = section.settings.seal_days | append: ' ' | append: section.settings.seal_unit | escape -%}
          {{ section.settings.seal_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: seal_alt }}
        {%- else -%}
          {%- assign seal_id = 'seal-' | append: section.id -%}
          <svg viewBox="0 0 120 120" width="88" height="88" role="img" aria-label="{{ section.settings.seal_top | escape }} {{ section.settings.seal_days | escape }} {{ section.settings.seal_unit | escape }} {{ section.settings.seal_bottom | escape }}">
            <defs>
              <path id="{{ seal_id }}-top" d="M 22 60 A 38 38 0 0 1 98 60"/>
              <path id="{{ seal_id }}-bottom" d="M 18 60 A 42 42 0 0 0 102 60"/>
            </defs>
            <circle cx="60" cy="60" r="57" fill="{{ section.settings.seal_color }}"/>
            <circle cx="60" cy="60" r="52" fill="none" stroke="#fff" stroke-width="1.2" stroke-dasharray="2 3"/>
            <circle cx="60" cy="60" r="33" fill="#fff"/>
            <text font-family="var(--font-heading-family), sans-serif" font-size="11" font-weight="800" fill="#fff" letter-spacing="1.5"><textPath href="#{{ seal_id }}-top" startOffset="50%" text-anchor="middle">{{ section.settings.seal_top | upcase }}</textPath></text>
            <text font-family="var(--font-heading-family), sans-serif" font-size="11" font-weight="800" fill="#fff" letter-spacing="1.5" dy="8"><textPath href="#{{ seal_id }}-bottom" startOffset="50%" text-anchor="middle">{{ section.settings.seal_bottom | upcase }}</textPath></text>
            <text x="60" y="62" text-anchor="middle" font-family="var(--font-heading-family), sans-serif" font-size="26" font-weight="800" fill="{{ section.settings.seal_color }}">{{ section.settings.seal_days }}</text>
            <text x="60" y="76" text-anchor="middle" font-family="var(--font-heading-family), sans-serif" font-size="10" font-weight="800" letter-spacing="1" fill="{{ section.settings.seal_color }}">{{ section.settings.seal_unit | upcase }}</text>
          </svg>
        {%- endif -%}
      </div>
      {%- if section.settings.heading != blank -%}<h2 class="y-heading y-h2 y-hl-text">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="y-rte y-guar__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="y-guar__btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "YUMI Garantie-Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Siegel" },
    { "type": "image_picker", "id": "seal_image", "label": "Eigenes Siegel-Bild (optional)", "info": "Ersetzt das eingebaute Siegel." },
    { "type": "text", "id": "seal_days", "label": "Zahl", "default": "30" },
    { "type": "text", "id": "seal_unit", "label": "Einheit", "default": "Days" },
    { "type": "text", "id": "seal_top", "label": "Text oben", "default": "Money back" },
    { "type": "text", "id": "seal_bottom", "label": "Text unten", "default": "Guarantee" },
    { "type": "color", "id": "seal_color", "label": "Siegel-Farbe", "default": "#9c5a85" },
    { "type": "header", "content": "Inhalt" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Younger-looking skin in 30 days or your money back" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Try YUMI Reverse-ageing Adaptive Foundation risk-free for 30 days. If you don't love your results, we'll make it right — no questions asked.</p>" },
    { "type": "text", "id": "button_label", "label": "Button-Text", "default": "Try it risk-free" },
    { "type": "url", "id": "button_link", "label": "Button-Link" },
    { "type": "color", "id": "button_color", "label": "Button-Farbe", "default": "#9c5a85" },
    { "type": "header", "content": "Layout" },
    { "type": "color_background", "id": "background", "label": "Hintergrund", "default": "linear-gradient(180deg, #f7d3e2 0%, #fbe9f1 100%)" },
    { "type": "range", "id": "max_width", "label": "Max. Breite", "min": 600, "max": 1400, "step": 20, "unit": "px", "default": 900 },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "YUMI Garantie-Banner" }]
}
{% endschema %}
