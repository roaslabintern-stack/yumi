{{ 'yumi-pdp.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} .y-section { --y-bg: {{ section.settings.background }}; --y-pt: {{ section.settings.padding_top }}px; --y-pb: {{ section.settings.padding_bottom }}px; --y-width: {{ section.settings.max_width }}px; }
  #shopify-section-{{ section.id }} .y-split__media { --y-ratio: {{ section.settings.image_ratio }}; }
</style>

{%- liquid
  assign bullets = section.blocks | where: 'type', 'bullet'
  assign steps = section.blocks | where: 'type', 'step'
-%}

<div class="y-section">
  <div class="y-container">
    <div class="y-split{% if section.settings.image_position == 'right' %} y-split--reverse{% endif %}">
      <div class="y-media y-split__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400, 600, 800, 1000, 1200' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'y-ph' }}
        {%- endif -%}
      </div>

      <div class="y-split__content">
        {%- if section.settings.eyebrow != blank -%}<span class="y-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="y-heading y-h2 {% if section.settings.highlight_style == 'pill' %}y-hl-pill{% else %}y-hl-text{% endif %}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}<div class="y-rte">{{ section.settings.text }}</div>{%- endif -%}

        {%- if steps.size > 0 -%}
          <div class="y-steps">
            {%- for block in steps -%}
              <div class="y-step" {{ block.shopify_attributes }}>
                {%- if block.settings.label != blank -%}<span class="y-step__pill">{{ block.settings.label }}</span>{%- endif -%}
                <p class="y-step__title">{{ block.settings.title }}</p>
                <div class="y-step__text">{{ block.settings.text }}</div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if bullets.size > 0 -%}
          <div class="y-bullets{% if section.settings.bullet_columns == '1' %} y-bullets--single{% endif %}">
            {%- for block in bullets -%}
              <div class="y-bullet" {{ block.shopify_attributes }}>
                {%- unless block.settings.icon == 'none' -%}{% render 'yumi-icon', icon: block.settings.icon %}{%- endunless -%}
                <span>{{ block.settings.text }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "YUMI Bild mit Text",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bild" },
    { "type": "select", "id": "image_position", "label": "Bildposition (Desktop)", "default": "left", "options": [
      { "value": "left", "label": "Links" }, { "value": "right", "label": "Rechts" }
    ] },
    { "type": "select", "id": "image_ratio", "label": "Bildformat", "default": "1 / 1", "options": [
      { "value": "1 / 1", "label": "Quadratisch" }, { "value": "4 / 5", "label": "Hochformat" }, { "value": "4 / 3", "label": "Querformat" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Kleine Überschrift" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Foundation, die <em>sich dir anpasst</em>", "info": "Kursiv formatierter Text wird hervorgehoben." },
    { "type": "select", "id": "highlight_style", "label": "Hervorhebung", "default": "pill", "options": [
      { "value": "pill", "label": "Farbiger Hintergrund" }, { "value": "text", "label": "Farbiger Text" }
    ] },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Lerne die Foundation kennen, die für Haut ab 50 gemacht ist. Die farbanpassende Formel passt sich in Sekunden deinem Hautton an, mildert feine Linien und schützt mit LSF 15 – ganz ohne Maskeneffekt.</p>" },
    { "type": "select", "id": "bullet_columns", "label": "Spalten für Vorteile", "default": "2", "options": [
      { "value": "1", "label": "1" }, { "value": "2", "label": "2" }
    ] },
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "background", "label": "Hintergrundfarbe", "default": "#ffffff" },
    { "type": "range", "id": "max_width", "label": "Max. Breite", "min": 700, "max": 1400, "step": 20, "unit": "px", "default": 900 },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Vorteil",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "check", "options": [
          { "value": "none", "label": "Kein Icon" }, { "value": "half_circle", "label": "Halbkreis" }, { "value": "sparkle", "label": "Funkeln" }, { "value": "clock", "label": "Uhr" }, { "value": "sun", "label": "Sonne" }, { "value": "drop", "label": "Tropfen" }, { "value": "heart", "label": "Herz" }, { "value": "leaf", "label": "Blatt" }, { "value": "shield", "label": "Schild" }, { "value": "star", "label": "Stern" }, { "value": "truck", "label": "Versand" }, { "value": "gift", "label": "Geschenk" }, { "value": "eye", "label": "Auge" }, { "value": "users", "label": "Personen" }, { "value": "flask", "label": "Labor" }, { "value": "check", "label": "Haken" }, { "value": "refresh", "label": "Erneuern" }
        ] },
        { "type": "text", "id": "text", "label": "Text", "default": "Passt sich deinem Hautton an" }
      ]
    },
    {
      "type": "step",
      "name": "Schritt",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "01 · In Sekunden" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Intelligente Pigmente erwachen" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Beim Auftragen brechen winzige Pigmentkapseln auf und passen sich deinem Hautton an.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "YUMI Bild mit Text",
      "blocks": [
        { "type": "bullet", "settings": { "icon": "half_circle", "text": "Passt sich deinem Hautton an" } },
        { "type": "bullet", "settings": { "icon": "sparkle", "text": "Kaschiert Unebenheiten" } }
      ]
    },
    {
      "name": "YUMI So funktioniert's",
      "settings": { "image_position": "right", "heading": "So funktioniert's", "text": "" },
      "blocks": [
        { "type": "step", "settings": { "label": "01 · In Sekunden", "title": "Intelligente Pigmente erwachen" } },
        { "type": "step", "settings": { "label": "02 · Beim Verblenden", "title": "Dein exakter Farbton entsteht" } },
        { "type": "step", "settings": { "label": "03 · Den ganzen Tag", "title": "Makelloses Finish – den ganzen Tag" } }
      ]
    }
  ]
}
{% endschema %}
