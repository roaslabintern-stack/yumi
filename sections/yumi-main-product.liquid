{{ 'yumi-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'yumi-pdp.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'y-product-form-' | append: section.id
  assign save_percent = 0
  if current_variant.compare_at_price > current_variant.price
    assign save_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif
  assign media_count = product.media.size
  assign thumb_limit = section.settings.thumbnail_limit
-%}

<style>
  :root {
    --yumi-accent: {{ section.settings.accent_color }};
    --yumi-accent-dark: {{ section.settings.accent_dark_color }};
    --yumi-accent-soft: {{ section.settings.accent_soft_color }};
  }
  #shopify-section-{{ section.id }} .y-section {
    --y-pt: {{ section.settings.padding_top }}px;
    --y-pb: {{ section.settings.padding_bottom }}px;
    --y-btn-bg: {{ section.settings.button_color }};
    --y-btn-text: {{ section.settings.button_text_color }};
    --y-fit: {{ section.settings.media_fit }};
  }
</style>

<div class="y-section" data-y-product>
  <div class="y-container">
    <div class="y-product">
      {%- comment -%} Gallery {%- endcomment -%}
      <div class="y-product__gallery{% if section.settings.sticky_gallery %} y-product__gallery--sticky{% endif %}" data-y-gallery>
        <div class="y-gallery__viewport">
          <div class="y-gallery__track">
            {%- if media_count > 0 -%}
              {%- for media in product.media -%}
                <div class="y-gallery__slide" data-media-id="{{ media.id }}">
                  {{- media.preview_image | image_url: width: 1400 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 560px, 100vw', widths: '400, 600, 800, 1000, 1200, 1400', alt: media.alt | escape -}}
                </div>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..9) -%}
                <div class="y-gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'y-ph' }}</div>
              {%- endfor -%}
            {%- endif -%}
          </div>

          {%- if section.settings.badge_image != blank or section.settings.badge_caption != blank or section.settings.badge_big != blank -%}
            <div class="y-gallery__badges">
              {%- if section.settings.badge_image != blank or section.settings.badge_caption != blank -%}
                <div class="y-badge-round">
                  {%- if section.settings.badge_image != blank -%}
                    <div class="y-badge-round__img">
                      {{ section.settings.badge_image | image_url: width: 200 | image_tag: loading: 'lazy' }}
                    </div>
                  {%- endif -%}
                  {%- if section.settings.badge_caption != blank -%}
                    <div class="y-badge-round__caption">{{ section.settings.badge_caption }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if section.settings.badge_big != blank -%}
                <div class="y-badge-circle">
                  <strong>{{ section.settings.badge_big }}</strong>
                  {%- if section.settings.badge_small != blank -%}<span>{{ section.settings.badge_small }}</span>{%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- if section.settings.show_thumbnails -%}
          <div class="y-gallery__thumbs{% if section.settings.hide_thumbnails_mobile %} y-gallery__thumbs--hide-mobile{% endif %}">
            {%- if media_count > 0 -%}
              {%- for media in product.media limit: thumb_limit -%}
                <button type="button" class="y-gallery__thumb" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}">
                  {{- media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' -}}
                </button>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..9) -%}
                <button type="button" class="y-gallery__thumb" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Bild {{ forloop.index }}">
                  {{- 'product-1' | placeholder_svg_tag: 'y-ph' -}}
                </button>
              {%- endfor -%}
            {%- endif -%}
          </div>
          <div class="y-gallery__dots" aria-hidden="true">
            {%- liquid
              assign dot_count = media_count
              if dot_count == 0
                assign dot_count = 9
              endif
            -%}
            {%- for i in (1..dot_count) -%}<span{% if forloop.first %} class="is-active"{% endif %}></span>{%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Product info {%- endcomment -%}
      <div class="y-info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'top_bar' -%}
              <div class="y-topbar" {{ block.shopify_attributes }}>
                {%- if block.settings.prefix != blank -%}<small>{{ block.settings.prefix }}</small>{%- endif -%}
                <span>{{ block.settings.text }}</span>
              </div>

            {%- when 'social_proof' -%}
              <div class="y-proof" {{ block.shopify_attributes }}>
                <div class="y-proof__avatars">
                  {%- assign avatars = 'avatar_1,avatar_2,avatar_3' | split: ',' -%}
                  {%- for key in avatars -%}
                    <span>
                      {%- if block.settings[key] != blank -%}
                        {{ block.settings[key] | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'y-ph' }}
                      {%- endif -%}
                    </span>
                  {%- endfor -%}
                </div>
                <span>{{ block.settings.text }}</span>
              </div>

            {%- when 'rating' -%}
              <div class="y-rating" {{ block.shopify_attributes }}>
                <span class="y-stars" aria-hidden="true">
                  {%- for i in (1..5) -%}<svg viewBox="0 0 20 20"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L10 14.9l-5.2 2.8 1-5.9L1.5 7.7l5.9-.8z"/></svg>{%- endfor -%}
                </span>
                <span>{{ block.settings.rating }}</span>
                {%- if block.settings.reviews_text != blank -%}
                  <span aria-hidden="true">·</span>
                  {%- if block.settings.reviews_link != blank -%}
                    <a href="{{ block.settings.reviews_link }}">{{ block.settings.reviews_text }}</a>
                  {%- else -%}
                    <span>{{ block.settings.reviews_text }}</span>
                  {%- endif -%}
                {%- endif -%}
              </div>

            {%- when 'title' -%}
              <h1 class="y-title" {{ block.shopify_attributes }}>
                {%- if block.settings.custom_title != blank -%}{{ block.settings.custom_title }}{%- else -%}{{ product.title | escape }}{%- endif -%}
              </h1>

            {%- when 'price' -%}
              <div {{ block.shopify_attributes }}>
                <div class="y-price">
                  <span class="y-price__current" data-y-price>{{ current_variant.price | money }}</span>
                  <s class="y-price__compare" data-y-compare{% if current_variant.compare_at_price <= current_variant.price %} hidden{% endif %}>
                    {%- if current_variant.compare_at_price > current_variant.price -%}{{ current_variant.compare_at_price | money }}{%- endif -%}
                  </s>
                  {%- if block.settings.show_save_badge -%}
                    <span class="y-price__save" data-y-save data-template="{{ block.settings.save_text | escape }}"{% if save_percent == 0 %} hidden{% endif %}>
                      {%- assign save_label = save_percent | append: '%' -%}
                      {{- block.settings.save_text | replace: '[percent]', save_label -}}
                    </span>
                  {%- endif -%}
                </div>
              </div>
              {%- if block.settings.installment_text != blank -%}
                {%- assign installment = current_variant.price | divided_by: block.settings.installment_count | money -%}
                <div class="y-installments" style="--y-pill-bg: {{ block.settings.installment_pill_color }};">
                  <span>{{ block.settings.installment_text | replace: '[amount]', '<strong data-y-installment>[amount]</strong>' | replace: '[amount]', installment }}</span>
                  {%- if block.settings.installment_pill != blank -%}<span class="y-installments__pill">{{ block.settings.installment_pill }}</span>{%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'description' -%}
              <div class="y-description" {{ block.shopify_attributes }}>
                {%- if block.settings.text != blank -%}{{ block.settings.text }}{%- else -%}{{ product.description }}{%- endif -%}
              </div>

            {%- when 'features' -%}
              <div class="y-features" {{ block.shopify_attributes }}>
                {%- for i in (1..4) -%}
                  {%- assign t_key = 'text_' | append: i -%}
                  {%- assign i_key = 'icon_' | append: i -%}
                  {%- if block.settings[t_key] != blank -%}
                    <div class="y-feature">
                      {%- unless block.settings[i_key] == 'none' -%}{% render 'yumi-icon', icon: block.settings[i_key] %}{%- endunless -%}
                      <span>{{ block.settings[t_key] }}</span>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="y-variants" data-y-picker {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    <fieldset class="y-variants" style="gap:0">
                      <legend class="y-variants__label">{{ option.name }}</legend>
                      <div class="y-variants__values">
                        {%- for value in option.values -%}
                          {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 -%}
                          <input type="radio" id="{{ input_id }}" name="{{ section.id }}-{{ option.name | handle }}" value="{{ value | escape }}"{% if value.selected %} checked{% endif %}{% unless value.available %} class="is-unavailable"{% endunless %}>
                          <label for="{{ input_id }}">{{ value }}</label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                </div>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <div data-y-main-atc {{ block.shopify_attributes }}>
                <product-form class="product-form">
                  {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                    <input type="hidden" name="id" value="{{ current_variant.id }}" disabled class="product-variant-id">
                    <button
                      type="submit"
                      name="add"
                      id="ProductSubmitButton-{{ section.id }}"
                      class="y-atc{% if block.settings.uppercase %} y-atc--upper{% endif %}"
                      data-y-atc-button
                      {% unless current_variant.available %}disabled{% endunless %}
                    >
                      <span>
                        <span data-y-atc-label data-available="{{ block.settings.label | escape }}" data-soldout="{{ 'products.product.sold_out' | t }}" data-unavailable="{{ 'products.product.unavailable' | t }}">
                          {%- if current_variant.available -%}{{ block.settings.label }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                        </span>
                        {%- if block.settings.show_price -%}
                          <span{% unless current_variant.available %} hidden{% endunless %}> · <span data-y-atc-price>{{ current_variant.price | money }}</span></span>
                        {%- endif -%}
                      </span>
                      <div class="loading-overlay__spinner hidden">
                        <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg"><circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle></svg>
                      </div>
                    </button>
                    {%- if block.settings.show_dynamic_checkout -%}
                      <div style="margin-top:10px">{{ form | payment_button }}</div>
                    {%- endif -%}
                  {%- endform -%}
                  <div class="product-form__error-message-wrapper y-form-error" role="alert" hidden>
                    <span class="product-form__error-message"></span>
                  </div>
                </product-form>
              </div>

            {%- when 'shipping' -%}
              <div class="y-shipline" {{ block.shopify_attributes }}>
                <span class="y-shipline__left">{% render 'yumi-icon', icon: 'check' %}{{ block.settings.left_text }}</span>
                {%- if block.settings.right_text != blank -%}
                  <span class="y-shipline__right">
                    {%- if block.settings.country_code != blank -%}<small>{{ block.settings.country_code }}</small>{%- endif -%}
                    <span>{{ block.settings.right_text }}</span>
                  </span>
                {%- endif -%}
              </div>

            {%- when 'stock' -%}
              <div {{ block.shopify_attributes }}>
                <p class="y-stock__title">{{ block.settings.title }}</p>
                {%- if block.settings.text != blank -%}<p class="y-stock__text">{{ block.settings.text }}</p>{%- endif -%}
                <div class="y-stock__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ block.settings.percent }}">
                  <span style="width: {{ block.settings.percent }}%"></span>
                </div>
                <div class="y-stock__meta">
                  <span>{{ block.settings.sold_text | replace: '[percent]', block.settings.percent }}</span>
                  {%- if block.settings.show_countdown -%}
                    <span>{{ block.settings.countdown_text }} <span data-y-countdown>--:--:--</span></span>
                  {%- endif -%}
                </div>
              </div>

            {%- when 'guarantee' -%}
              <div class="y-guarantee" {{ block.shopify_attributes }}>
                {%- if block.settings.badge != blank -%}<span class="y-guarantee__badge">{{ block.settings.badge }}</span>{%- endif -%}
                <div>
                  <p class="y-guarantee__title">{{ block.settings.title }}</p>
                  <div class="y-guarantee__text">{{ block.settings.text }}</div>
                </div>
              </div>

            {%- when 'accordion' -%}
              <details class="y-accordion" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
                <summary>{{ block.settings.heading }}<span class="y-plus" aria-hidden="true"></span></summary>
                <div class="y-accordion__content y-rte">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                </div>
              </details>

            {%- when 'custom_liquid' -%}
              <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if section.settings.enable_sticky_atc -%}
    <div class="y-sticky" data-y-sticky>
      <div class="y-sticky__inner">
        <div class="y-sticky__product">
          {%- if product.featured_media -%}
            {{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'y-ph' }}
          {%- endif -%}
          <div>
            <div class="y-sticky__title">{{ product.title | default: 'Produktname' | escape }}</div>
            <div class="y-sticky__price">
              <span data-y-price>{{ current_variant.price | money }}</span>
              <s data-y-compare{% if current_variant.compare_at_price <= current_variant.price %} hidden{% endif %}>{% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | money }}{% endif %}</s>
            </div>
          </div>
        </div>
        <button type="button" class="y-atc" data-y-sticky-btn data-y-atc-button{% unless current_variant.available %} disabled{% endunless %}>
          <span data-y-atc-label data-available="{{ section.settings.sticky_label | escape }}" data-soldout="{{ 'products.product.sold_out' | t }}" data-unavailable="{{ 'products.product.unavailable' | t }}">
            {%- if current_variant.available -%}{{ section.settings.sticky_label }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
          </span>
        </button>
      </div>
    </div>
  {%- endif -%}

  <script type="application/json" data-y-variants>
    [
      {%- for variant in product.variants -%}
        {%- liquid
          assign v_save = 0
          if variant.compare_at_price > variant.price
            assign v_save = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
          endif
          assign v_compare = ''
          if variant.compare_at_price > variant.price
            assign v_compare = variant.compare_at_price | money
          endif
          assign v_installment = variant.price | divided_by: 4 | money
          for block in section.blocks
            if block.type == 'price' and block.settings.installment_count > 0
              assign v_installment = variant.price | divided_by: block.settings.installment_count | money
            endif
          endfor
        -%}
        {
          "id": {{ variant.id }},
          "available": {{ variant.available | json }},
          "options": {{ variant.options | json }},
          "price": {{ variant.price | money | json }},
          "compare": {{ v_compare | json }},
          "save": {{ v_save }},
          "installment": {{ v_installment | json }},
          "media_id": {{ variant.featured_media.id | default: 'null' }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</div>

{% schema %}
{
  "name": "YUMI Produkt",
  "tag": "section",
  "class": "section",
  "blocks": [
    { "type": "@app" },
    {
      "type": "top_bar",
      "name": "Info-Leiste",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "prefix", "label": "Kürzel (z. B. Ländercode)", "default": "KR" },
        { "type": "text", "id": "text", "label": "Text", "default": "Die #1 Foundation in Korea" }
      ]
    },
    {
      "type": "social_proof",
      "name": "Social Proof",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "avatar_1", "label": "Avatar 1" },
        { "type": "image_picker", "id": "avatar_2", "label": "Avatar 2" },
        { "type": "image_picker", "id": "avatar_3", "label": "Avatar 3" },
        { "type": "text", "id": "text", "label": "Text", "default": "Linda & 50.000+ andere haben gekauft" }
      ]
    },
    {
      "type": "rating",
      "name": "Bewertung",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "rating", "label": "Bewertung", "default": "4,8/5" },
        { "type": "text", "id": "reviews_text", "label": "Bewertungs-Text", "default": "7.481 Bewertungen" },
        { "type": "url", "id": "reviews_link", "label": "Link (z. B. zu den Bewertungen)" }
      ]
    },
    {
      "type": "title",
      "name": "Titel",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "custom_title", "label": "Eigener Titel", "info": "Leer lassen, um den Produkttitel zu verwenden." }
      ]
    },
    {
      "type": "price",
      "name": "Preis",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_save_badge", "label": "Ersparnis-Badge anzeigen", "default": true },
        { "type": "text", "id": "save_text", "label": "Badge-Text", "default": "Spare [percent]", "info": "[percent] wird durch die Ersparnis in % ersetzt." },
        { "type": "header", "content": "Ratenzahlung" },
        { "type": "text", "id": "installment_text", "label": "Text", "default": "oder 4 zinsfreie Raten à [amount] mit", "info": "[amount] wird durch den Ratenbetrag ersetzt. Leer lassen zum Ausblenden." },
        { "type": "range", "id": "installment_count", "label": "Anzahl Raten", "min": 2, "max": 12, "step": 1, "default": 4 },
        { "type": "text", "id": "installment_pill", "label": "Anbieter-Label", "default": "Klarna." },
        { "type": "color", "id": "installment_pill_color", "label": "Label-Farbe", "default": "#ffb3c7" }
      ]
    },
    {
      "type": "description",
      "name": "Beschreibung",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "info": "Leer lassen, um die Produktbeschreibung zu verwenden.", "default": "<p><strong>Mit koreanischer Beauty-Innovation entwickelt – speziell für Haut ab 50.</strong> Sie mildert Fältchen, kaschiert Altersflecken und belebt müde wirkende Haut – mit einem perfekten, sich selbst anpassenden Farbton.</p>" }
      ]
    },
    {
      "type": "features",
      "name": "Vorteile (Icons)",
      "settings": [
        { "type": "select", "id": "icon_1", "label": "Icon 1", "default": "half_circle", "options": [
          { "value": "none", "label": "Kein Icon" }, { "value": "half_circle", "label": "Halbkreis" }, { "value": "sparkle", "label": "Funkeln" }, { "value": "clock", "label": "Uhr" }, { "value": "sun", "label": "Sonne" }, { "value": "drop", "label": "Tropfen" }, { "value": "heart", "label": "Herz" }, { "value": "leaf", "label": "Blatt" }, { "value": "shield", "label": "Schild" }, { "value": "star", "label": "Stern" }, { "value": "truck", "label": "Versand" }, { "value": "gift", "label": "Geschenk" }, { "value": "eye", "label": "Auge" }, { "value": "users", "label": "Personen" }, { "value": "flask", "label": "Labor" }, { "value": "check", "label": "Haken" }, { "value": "refresh", "label": "Erneuern" }
        ] },
        { "type": "text", "id": "text_1", "label": "Text 1", "default": "Passt sich deinem Hautton an" },
        { "type": "select", "id": "icon_2", "label": "Icon 2", "default": "sparkle", "options": [
          { "value": "none", "label": "Kein Icon" }, { "value": "half_circle", "label": "Halbkreis" }, { "value": "sparkle", "label": "Funkeln" }, { "value": "clock", "label": "Uhr" }, { "value": "sun", "label": "Sonne" }, { "value": "drop", "label": "Tropfen" }, { "value": "heart", "label": "Herz" }, { "value": "leaf", "label": "Blatt" }, { "value": "shield", "label": "Schild" }, { "value": "star", "label": "Stern" }, { "value": "truck", "label": "Versand" }, { "value": "gift", "label": "Geschenk" }, { "value": "eye", "label": "Auge" }, { "value": "users", "label": "Personen" }, { "value": "flask", "label": "Labor" }, { "value": "check", "label": "Haken" }, { "value": "refresh", "label": "Erneuern" }
        ] },
        { "type": "text", "id": "text_2", "label": "Text 2", "default": "Kaschiert Unebenheiten" },
        { "type": "select", "id": "icon_3", "label": "Icon 3", "default": "clock", "options": [
          { "value": "none", "label": "Kein Icon" }, { "value": "half_circle", "label": "Halbkreis" }, { "value": "sparkle", "label": "Funkeln" }, { "value": "clock", "label": "Uhr" }, { "value": "sun", "label": "Sonne" }, { "value": "drop", "label": "Tropfen" }, { "value": "heart", "label": "Herz" }, { "value": "leaf", "label": "Blatt" }, { "value": "shield", "label": "Schild" }, { "value": "star", "label": "Stern" }, { "value": "truck", "label": "Versand" }, { "value": "gift", "label": "Geschenk" }, { "value": "eye", "label": "Auge" }, { "value": "users", "label": "Personen" }, { "value": "flask", "label": "Labor" }, { "value": "check", "label": "Haken" }, { "value": "refresh", "label": "Erneuern" }
        ] },
