{{ 'yumi-pdp.css' | asset_url | stylesheet_tag }}
{{ 'yumi-adv.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} .y-section { --y-pt: {{ section.settings.padding_top }}px; --y-pb: {{ section.settings.padding_bottom }}px; }
  #shopify-section-{{ section.id }} .yadv-offer { --offer-bg: {{ section.settings.background }}; }
</style>

{%- liquid
  assign p = section.settings.product
  assign link = section.settings.button_link
  if link == blank and p != blank
    assign link = p.url
  endif
  if link == blank
    assign link = routes.all_products_collection_url
  endif
-%}
<div class="y-section" id="yadv-offer">
  <div class="yadv-offer">
    <div class="yadv-offer__media">
      {%- if section.settings.badge != blank -%}<span class="yadv-offer__badge">{{ section.settings.badge }}</span>{%- endif -%}
      <a href="{{ link }}" tabindex="-1" aria-hidden="true">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 380px, 100vw', widths: '380, 600, 900', alt: '' }}
        {%- elsif p.featured_media -%}
          {{ p.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 380px, 100vw', widths: '380, 600, 900', alt: '' }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'y-ph' }}
        {%- endif -%}
      </a>
    </div>
    <div class="yadv-offer__content">
      {%- if section.settings.heading != blank -%}<p class="yadv-offer__heading">{{ section.settings.heading }}</p>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="yadv-offer__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="yadv-offer__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}<a class="yadv-btn" href="{{ link }}">{{ section.settings.button_label }}</a>{%- endif -%}
      {%- if section.settings.note != blank -%}<p class="yadv-offer__note">{{ section.settings.note }}</p>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Advertorial Angebot",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Produkt", "info": "Für Link und Bild, falls unten nichts gesetzt ist." },
    { "type": "image_picker", "id": "image", "label": "Bild (optional)" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "60% OFF" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "60% OFF" },
    { "type": "text", "id": "subheading", "label": "Unterzeile", "default": "+ FREE YUMI Blender, Mystery Gift & Shipping" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>I was sceptical too. But with free shipping and a 30-day guarantee, there's nothing to lose.</p>" },
    { "type": "text", "id": "button_label", "label": "Button-Text", "default": "Shop now →" },
    { "type": "url", "id": "button_link", "label": "Button-Link", "info": "Leer = Produktseite." },
    { "type": "text", "id": "note", "label": "Hinweis", "default": "Try it today with a 30-day money-back guarantee" },
    { "type": "color", "id": "background", "label": "Hintergrund", "default": "#ece4f2" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Advertorial Angebot" }]
}
{% endschema %}
