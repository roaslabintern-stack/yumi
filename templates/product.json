        "acc_1": {
          "type": "accordion",
          "settings": {
            "heading": "Was macht sie besonders?",
            "content": "<p>Unsere Foundation enthält farbverändernde Pigmente, die sich beim Auftragen an deinen individuellen Hautton anpassen – für einen natürlichen Look ohne Farbton-Suche.</p>"
          }
        },
        "acc_2": {
          "type": "accordion",
          "settings": {
            "heading": "Funktioniert sie bei meiner Haut?",
            "content": "<p>Die Formel wurde für reife Haut entwickelt und passt sich hellen bis mittleren Hauttönen an.</p>"
          }
        },
        "acc_3": {
          "type": "accordion",
          "settings": {
            "heading": "Wie wende ich sie an?",
            "content": "<p>Eine kleine Menge auf Stirn, Wangen und Kinn geben und sanft verblenden – mit den Fingern, einem Pinsel oder einem Schwämmchen.</p>"
          }
        },
        "acc_4": {
          "type": "accordion",
          "settings": {
            "heading": "Wie funktioniert die Geld-zurück-Garantie?",
            "content": "<p>Du hast 30 Tage Zeit, die Foundation zu testen. Bist du nicht zufrieden, erstatten wir dir den Kaufpreis.</p>"
          }
        },
        "acc_5": {
          "type": "accordion",
          "settings": {
            "heading": "Inhaltsstoffe",
            "content": "<p>Hier die vollständige Liste der Inhaltsstoffe einfügen.</p>"
          }
        },
        "acc_6": {
          "type": "accordion",
          "settings": {
            "heading": "Versand & Rückgabe",
            "content": "<p>Kostenloser Versand innerhalb Deutschlands. Bearbeitungszeit 1–2 Werktage, Lieferzeit 3–7 Werktage. Rückgabe innerhalb von 30 Tagen.</p>"
          }
        }
