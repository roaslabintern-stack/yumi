        "step_1": {
          "type": "step",
          "settings": {
            "label": "01 · In Sekunden",
            "title": "Intelligente Pigmente erwachen",
            "text": "<p>Beim Auftragen brechen winzige Pigmentkapseln auf und passen sich deinem Hautton an.</p>"
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "label": "02 · Beim Verblenden",
            "title": "Dein exakter Farbton entsteht",
            "text": "<p>Während du verblendest, gleicht die Formel Rötungen und Altersflecken aus – für einen ebenmäßigen Teint.</p>"
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "label": "03 · Den ganzen Tag",
            "title": "Makelloses Finish – den ganzen Tag",
            "text": "<p>Leicht, atmungsaktiv und langanhaltend – ohne sich in Fältchen abzusetzen. Mit LSF 15.</p>"
          }
        }
      },
